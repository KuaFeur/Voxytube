# Required public HTTPS callback URL. The path must end in /websub.
PUBLIC_CALLBACK_URL=https://youtube.example.com/websub

# Protects /api/v1/* management endpoints. Generate with: openssl rand -hex 32
API_TOKEN=replace-with-at-least-32-random-characters

# Destination that receives normalized video event JSON. Leave empty to disable delivery.
WEBHOOK_URL=
WEBHOOK_TOKEN=

# Embedded PostgreSQL settings (container entrypoint)
POSTGRES_DB=voxytube
POSTGRES_USER=voxytube
# POSTGRES_PASSWORD= (leave empty to generate and persist a random password)
# POSTGRES_RESTORE_FILE= (optional custom-format pg_dump file to restore once on startup)

# Runtime
PORT=8080
DATABASE_MAX_CONNECTIONS=10
RSS_INTERVAL_SECONDS=300
WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe
RUST_LOG=voxytube=info,tower_http=info
