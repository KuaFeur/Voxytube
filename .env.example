# Local development only. The Pelican/Pterodactyl container creates and runs
# its own PostgreSQL instance and injects DATABASE_URL automatically.
DATABASE_URL=postgres://voxytube:change-me@127.0.0.1:5432/voxytube

# HTTP listener (expose through an HTTPS reverse proxy)
PORT=8080
DATABASE_MAX_CONNECTIONS=10

RUST_LOG=voxytube=info,tower_http=info
